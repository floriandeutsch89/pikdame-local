# Pik Dame - hardened Caddyfile (production reverse proxy)
# Domain and ACME e-mail come from the environment (.env next to the
# compose file): PIKDAME_DOMAIN, ACME_EMAIL.
{
	# No runtime admin API - configuration changes go through redeploys.
	admin off
	# ACME account e-mail for Let's Encrypt (expiry notices etc.)
	email {$ACME_EMAIL}

	# CrowdSec bouncer (compiled in via docker/caddy/Dockerfile): asks the
	# local CrowdSec API for every request and blocks banned IPs.
	# The API key is created once via: cscli bouncers add caddy-bouncer
	crowdsec {
		api_url http://crowdsec:8080
		api_key {$CROWDSEC_API_KEY}
	}
	order crowdsec first
}

{$PIKDAME_DOMAIN} {
	crowdsec
	encode zstd gzip

	header {
		# TLS-only from here on (browsers remember for a year)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# The game is never meant to be embedded
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Do not advertise the server software
		-Server
		# Popups (share sheet, mail links) must not get a handle on this window
		Cross-Origin-Opener-Policy "same-origin"
		# Content-Security-Policy. Everything is same-origin (no CDN), so
		# 'self' covers scripts, styles, images and the manifest. The
		# WebSocket origin is spelled out on top: Safari has not always
		# matched wss:// against 'self', and iOS is the primary device -
		# a blocked socket would mean a game stuck at 'Verbinde...'.
		# The ONE inline script is the splash pre-check in index.html; it is
		# allowed by its sha256 hash. If you edit that script, the hash
		# changes - test/csp-contract.test.js recomputes it and fails the
		# build, so it cannot silently break the page.
		# style-src keeps 'unsafe-inline': the client writes style attributes
		# via the CSSOM and inline SVG carries presentation attributes.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-jH3KSOBSxaye5mHx5q4GBJOSkH+yreYI2RN3bj4LMGc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss://{$PIKDAME_DOMAIN}; manifest-src 'self'; worker-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
	}

	# WebSockets are proxied automatically by Caddy.
	reverse_proxy pikdame:8080 {
		# Pass the real client IP for the app's IP-based rate limits
		# (the app must run with PIKDAME_TRUST_PROXY=1).
		header_up X-Forwarded-For {remote_host}
	}

	# JSON access log to the shared volume - CrowdSec tails this file
	# (container logs keep errors/runtime messages on stdout).
	# Access log exists ONLY for CrowdSec's attack detection. Retention is
	# deliberately short (privacy policy promises <= 48h): small rolls, two
	# files max, hard age cap. For debugging beyond that window, raise
	# roll_keep_for temporarily and reload - do not forget to lower it again.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 2
			roll_keep_for 48h
		}
		format json
	}
}
