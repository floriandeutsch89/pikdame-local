# Pik Dame - beta host environment (docker-compose.beta.yml, docs/admin/beta.md).
# Copy to ".env" ON THE BETA HOST. Passwords live in secrets/, not here.

PIKDAME_BETA_DOMAIN=beta.play.pikdame.online

# Own SMTP login for beta (password -> secrets/smtp_password.txt), so PR code
# never holds the production mail credential.
# PIKDAME_SMTP_RELAY_HOST=smtp.eu.mailgun.org
# PIKDAME_SMTP_RELAY_PORT=587
PIKDAME_SMTP_USER=beta@pikdame.online
PIKDAME_MAIL_FROM=Pik Dame Beta <noreply@pikdame.online>

# Optional /admin on beta; argon2id hash of a password OTHER than prod's.
# PIKDAME_BETA_ADMIN_TOKEN='$argon2id$...'
