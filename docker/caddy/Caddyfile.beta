# Pik Dame - beta preview host (docs/admin/beta.md): latest PR push, own server.
# Built per PR push (Dockerfile.beta); security headers come from the app.
# No CrowdSec: throwaway data, not indexed.
{
	admin off
	email {$ACME_EMAIL}
}

import site.caddy

{$PIKDAME_BETA_DOMAIN} {
	import site {$PIKDAME_BETA_DOMAIN} pikdame-beta:8080
	header X-Robots-Tag "noindex, nofollow"
}
