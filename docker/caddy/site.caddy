# Proxy snippet shared by prod (Caddyfile) and beta (Caddyfile.beta).
# Security headers (CSP, HSTS, ...) come from the app (game/SecurityHeaders.js):
# setting them here would overwrite the app's and drift from index.html.
# {args[0]} = public domain, {args[1]} = upstream host:port
(site) {
	encode zstd gzip

	# Do not advertise the server software
	header -Server

	# WebSockets are proxied automatically by Caddy.
	reverse_proxy {args[1]} {
		# Pass the real client IP for the app's IP-based rate limits
		# (the app must run with PIKDAME_TRUST_PROXY=1).
		header_up X-Forwarded-For {remote_host}
		# A config reload must not drop running games.
		stream_close_delay 5m
	}
}
