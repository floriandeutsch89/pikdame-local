# Keep the build context minimal: only server.js, game/, public/ and the
# package manifests are needed (see COPY statements in the Dockerfile).
.git
.github
node_modules
data
test
k8s
docker
scripts
# ...except the asset minifier: the image build minifies public/ with it
# (see stage "assets" in docker/Dockerfile). The rest of scripts/ is
# development tooling and stays out of the context.
!scripts/minify-assets.js
landing
docs
*.md
# ...except the changelog: /changelogz serves it (the in-app 'what's new')
!CHANGELOG.md
.dockerignore
docker-compose*.yml
Dockerfile
